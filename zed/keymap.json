// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    // JetBrains-style navigation. The Editor context is more specific than the
    // Workspace context these keys are bound to by default, so the defaults
    // (cmd-b ToggleLeftDock, cmd-shift-b outline_panel::ToggleFocus,
    // cmd-shift-r task::Spawn) stay reachable whenever focus is outside the editor.
    "context": "Editor",
    "bindings": {
      "cmd-shift-r": "editor::Rename",
      "cmd-b": "editor::GoToDefinition",
      "cmd-shift-b": "editor::GoToDefinitionSplit"
    }
  }
]
